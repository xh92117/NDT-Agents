# Local runtime configuration paths. Export these values in the process or IDE.
NDT_MODEL_CONFIG=config/runtime/model-bindings.local.yaml
NDT_PROMPT_CONFIG=prompts/professional/catalog.v1.yaml
NDT_AGENT_CONFIG=config/runtime/agent-runtime.local.yaml
NDT_MODEL_ENV_FILE=.env

# Hosted model credentials. Keep unused entries blank and enable only selected YAML bindings.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
ZHIPU_API_KEY=
MINIMAX_API_KEY=
QIANFAN_API_KEY=
HUNYUAN_API_KEY=
ARK_API_KEY=

# MinerU currently runs through the pinned local CLI adapter.
MINERU_BACKEND=local-cli
MINERU_MODEL_SOURCE=modelscope

# Reserved for a future separately registered hosted MinerU adapter; not active today.
MINERU_API_BASE_URL=https://mineru.net
MINERU_API_TOKEN=
