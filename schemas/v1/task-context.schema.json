{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Artifact Version",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/DataClassification"
        },
        "immutable": {
          "title": "Immutable",
          "type": "boolean"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/TenantScope"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "scope",
        "artifact_version",
        "uri",
        "media_type",
        "size_bytes",
        "sha256",
        "classification",
        "immutable"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BudgetPolicy": {
      "additionalProperties": false,
      "properties": {
        "correction_rounds": {
          "$ref": "#/$defs/Limit"
        },
        "graph_steps": {
          "$ref": "#/$defs/Limit"
        },
        "llm_calls": {
          "$ref": "#/$defs/Limit"
        },
        "policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "professional_concurrency": {
          "$ref": "#/$defs/Limit"
        },
        "review_rounds": {
          "$ref": "#/$defs/Limit"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_class": {
          "enum": [
            "G0",
            "P1",
            "P2",
            "P3",
            "K1"
          ],
          "title": "Task Class",
          "type": "string"
        },
        "tool_calls": {
          "$ref": "#/$defs/Limit"
        },
        "total_tokens": {
          "$ref": "#/$defs/Limit"
        },
        "wall_time_ms": {
          "$ref": "#/$defs/Limit"
        }
      },
      "required": [
        "policy_id",
        "task_class",
        "graph_steps",
        "llm_calls",
        "tool_calls",
        "total_tokens",
        "wall_time_ms",
        "professional_concurrency",
        "review_rounds",
        "correction_rounds"
      ],
      "title": "BudgetPolicy",
      "type": "object"
    },
    "DataClassification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "Limit": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "minimum": 0,
          "title": "Active",
          "type": "integer"
        },
        "default": {
          "minimum": 0,
          "title": "Default",
          "type": "integer"
        },
        "hard": {
          "minimum": 0,
          "title": "Hard",
          "type": "integer"
        }
      },
      "required": [
        "default",
        "active",
        "hard"
      ],
      "title": "Limit",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "TenantScope": {
      "additionalProperties": false,
      "properties": {
        "permission_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Permission Version",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "role_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Role Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "project_id",
        "user_id",
        "role_codes",
        "permission_version"
      ],
      "title": "TenantScope",
      "type": "object"
    }
  },
  "$id": "https://schemas.ndt-agents.local/v1/task-context.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_tools": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Tools",
      "type": "array"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/BudgetPolicy"
    },
    "context_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Context Manifest Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dependency_data": {
      "additionalProperties": true,
      "title": "Dependency Data",
      "type": "object"
    },
    "goal": {
      "maxLength": 8000,
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "knowledge_versions": {
      "items": {
        "type": "string"
      },
      "title": "Knowledge Versions",
      "type": "array"
    },
    "model_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Model Versions",
      "type": "object"
    },
    "output_schema_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Output Schema Id",
      "type": "string"
    },
    "prompt_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Prompt Versions",
      "type": "object"
    },
    "review_checklist": {
      "items": {
        "type": "string"
      },
      "title": "Review Checklist",
      "type": "array"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/TenantScope"
    },
    "skill_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Skill Versions",
      "type": "object"
    },
    "success_criteria": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Success Criteria",
      "type": "array"
    },
    "task_class": {
      "enum": [
        "G0",
        "P1",
        "P2",
        "P3",
        "K1"
      ],
      "title": "Task Class",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "scope",
    "task_class",
    "goal",
    "success_criteria",
    "risk_level",
    "dependency_data",
    "context_manifest_sha256",
    "artifacts",
    "skill_versions",
    "prompt_versions",
    "model_versions",
    "knowledge_versions",
    "allowed_tools",
    "budget",
    "output_schema_id",
    "review_checklist",
    "created_at"
  ],
  "title": "TaskContext",
  "type": "object",
  "x-contract-version": "1.0.0"
}
