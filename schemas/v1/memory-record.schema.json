{
  "$defs": {
    "DataClassification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "MemoryScope": {
      "enum": [
        "RUNTIME",
        "SESSION",
        "USER",
        "PROJECT",
        "AUDIT"
      ],
      "title": "MemoryScope",
      "type": "string"
    },
    "TenantScope": {
      "additionalProperties": false,
      "properties": {
        "permission_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Permission Version",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "role_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Role Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "project_id",
        "user_id",
        "role_codes",
        "permission_version"
      ],
      "title": "TenantScope",
      "type": "object"
    }
  },
  "$id": "https://schemas.ndt-agents.local/v1/memory-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_state": {
      "enum": [
        "CANDIDATE",
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ],
      "title": "Approval State",
      "type": "string"
    },
    "classification": {
      "$ref": "#/$defs/DataClassification"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "content": {
      "additionalProperties": true,
      "title": "Content",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expires At"
    },
    "memory_id": {
      "format": "uuid",
      "title": "Memory Id",
      "type": "string"
    },
    "memory_scope": {
      "$ref": "#/$defs/MemoryScope"
    },
    "provenance_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "minItems": 1,
      "title": "Provenance Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/TenantScope"
    }
  },
  "required": [
    "memory_id",
    "scope",
    "memory_scope",
    "content",
    "provenance_ids",
    "confidence",
    "classification",
    "approval_state",
    "expires_at",
    "created_at"
  ],
  "title": "MemoryRecord",
  "type": "object",
  "x-contract-version": "1.0.0"
}
