{
  "$defs": {
    "AgentStatus": {
      "enum": [
        "SUCCESS",
        "PARTIAL_SUCCESS",
        "NEEDS_USER",
        "HUMAN_REQUIRED",
        "FAILED",
        "BLOCKED"
      ],
      "title": "AgentStatus",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Artifact Version",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/DataClassification"
        },
        "immutable": {
          "title": "Immutable",
          "type": "boolean"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/TenantScope"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "scope",
        "artifact_version",
        "uri",
        "media_type",
        "size_bytes",
        "sha256",
        "classification",
        "immutable"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CitationRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "citation_id": {
          "format": "uuid",
          "title": "Citation Id",
          "type": "string"
        },
        "claim_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "locator": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "locator_type": {
          "enum": [
            "PAGE",
            "SECTION",
            "CLAUSE",
            "TABLE",
            "FIGURE",
            "CELL",
            "LINE"
          ],
          "title": "Locator Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "citation_id",
        "artifact_id",
        "source_sha256",
        "locator_type",
        "locator",
        "claim_id"
      ],
      "title": "CitationRef",
      "type": "object"
    },
    "DataClassification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ],
      "title": "DataClassification",
      "type": "string"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "affected_path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Path"
        },
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "next_action": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Action"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "TenantScope": {
      "additionalProperties": false,
      "properties": {
        "permission_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Permission Version",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "role_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Role Codes",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        },
        "user_id": {
          "format": "uuid",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "project_id",
        "user_id",
        "role_codes",
        "permission_version"
      ],
      "title": "TenantScope",
      "type": "object"
    }
  },
  "$id": "https://schemas.ndt-agents.local/v1/agent-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/CitationRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "failure_code": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AgentStatus"
    },
    "structured_data": {
      "additionalProperties": true,
      "title": "Structured Data",
      "type": "object"
    },
    "summary": {
      "maxLength": 12000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "run_id",
    "status",
    "summary",
    "structured_data",
    "artifacts",
    "evidence",
    "confidence",
    "issues",
    "retryable",
    "completed_at"
  ],
  "title": "AgentResult",
  "type": "object",
  "x-contract-version": "1.0.0"
}
